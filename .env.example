# Elastic Cloud API key (optional — for creating a new Serverless project)
EC_API_KEY=
EC_BASE_URL=https://api.elastic-cloud.com

# Elastic Serverless Elasticsearch
ELASTICSEARCH_URL=https://your-project.es.us-east-1.aws.elastic.cloud
ELASTICSEARCH_PUBLIC_URL=https://your-project.es.us-east-1.aws.elastic.cloud

# Write key for Cursor automation (index/create on solis-watch)
ELASTICSEARCH_API_KEY=

# Read-only key for GitHub Pages — create in Kibana → API Keys, not derived from write key
ELASTICSEARCH_READ_API_KEY=
