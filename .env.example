# Cursor Automation webhook — pushes to Cursor Mobile when local_watch finds new listings.
# Create at https://cursor.com/automations (Webhook trigger, no repo required).
# After saving, copy the webhook URL and generate an auth header (Bearer crsr_...).
CURSOR_AUTOMATION_WEBHOOK_URL=https://api2.cursor.sh/automations/webhook/YOUR_AUTOMATION_ID
CURSOR_AUTOMATION_TOKEN=crsr_YOUR_TOKEN
